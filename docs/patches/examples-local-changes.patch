diff --git a/cmake/mm-fw-gen/firmware/CMakeLists.txt b/cmake/mm-fw-gen/firmware/CMakeLists.txt
index 38a1e10..07cc765 100644
--- a/cmake/mm-fw-gen/firmware/CMakeLists.txt
+++ b/cmake/mm-fw-gen/firmware/CMakeLists.txt
@@ -62,6 +62,11 @@ endif()
 if(NOT EXISTS "${FW_ELF}")
     message(FATAL_ERROR "firmware ELF '${FW_BIN_NAME}' not found under ${MORSE_FW_DIR}/firmware/")
 endif()
+# local change: a ready-made calibration .mbin (Heltec's) may be given in RC_BCF_MBIN.
+set(RC_BCF_READY "$ENV{RC_BCF_MBIN}")
+if(RC_BCF_READY AND EXISTS "${RC_BCF_READY}")
+    set(BCF_ELF "${RC_BCF_READY}")
+endif()
 if(NOT BCF_ELF OR NOT EXISTS "${BCF_ELF}")
     message(FATAL_ERROR "BCF ELF '${BCF_BIN_NAME}' not found under ${MORSE_FW_DIR}/bcf/")
 endif()
@@ -78,12 +83,21 @@ add_custom_command(
     DEPENDS "${FW_ELF}" "${MBIN_CONVERTER}"
     COMMENT "Converting firmware ELF -> ${CONFIG_MM_FW_FILE}"
     VERBATIM)
+if(RC_BCF_READY AND EXISTS "${RC_BCF_READY}")
+add_custom_command(
+    OUTPUT "${BCF_MBIN}"
+    COMMAND "${CMAKE_COMMAND}" -E copy "${RC_BCF_READY}" "${BCF_MBIN}"
+    DEPENDS "${RC_BCF_READY}"
+    COMMENT "Copying ready-made BCF -> ${CONFIG_MM_BCF_FILE}"
+    VERBATIM)
+else()
 add_custom_command(
     OUTPUT "${BCF_MBIN}"
     COMMAND "${python}" "${MBIN_CONVERTER}" -o "${BCF_MBIN}" "${BCF_ELF}"
     DEPENDS "${BCF_ELF}" "${MBIN_CONVERTER}"
     COMMENT "Converting BCF ELF -> ${CONFIG_MM_BCF_FILE}"
     VERBATIM)
+endif()
 
