diff --git a/examples/mesh/CMakeLists.txt b/examples/mesh/CMakeLists.txt
index df7f98b..3dc0183 100644
--- a/examples/mesh/CMakeLists.txt
+++ b/examples/mesh/CMakeLists.txt
@@ -14,3 +14,12 @@ morse_firmware_generate_component()
 
 include($ENV{IDF_PATH}/tools/cmake/project.cmake)
 project(mesh)
+
+# local change: library debug logging on the console.
+target_compile_definitions(libmorse PRIVATE MMLOG_LEVEL_DEFAULT=5)
